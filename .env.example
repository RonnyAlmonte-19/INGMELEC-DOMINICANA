# ========================================================================
# INGMELEC | ALMACÉN GENERAL - VARIABLES DE ENTORNO DE PRODUCCIÓN / RENDER
# Ejemplo seguro de configuración (No incluir credenciales reales aquí)
# ========================================================================

# Configuración de Servidor Express
PORT=5000
NODE_ENV=production

# Base de Datos MySQL Relacional (Clever Cloud / RDS / MariaDB)
DB_HOST=tu-host-mysql.services.clever-cloud.com
DB_PORT=3306
DB_USER=tu-usuario-mysql
DB_PASSWORD=tu-contrasena-segura
DB_NAME=tu-base-de-datos
DB_SSL=false

# Clave Secreta para Firma Criptográfica de Tokens JWT (HS256, mínimo 32 caracteres)
JWT_SECRET=reemplazar-por-clave-criptografica-aleatoria-minimo-32-caracteres
