-- =================================================================================
-- INGMELEC | ALMACÉN GENERAL (v2.1 — ETAPA 6)
-- PROPUESTA FUTURA IDEMPOTENTE: CLAVES FORÁNEAS, INTEGRIDAD KÁRDEX E ÍNDICES ÓPTIMOS
-- ARCHIVO: server/database/migrations/migration_06_v21_integridad_fk_indices.sql
-- HALLAZGOS RELACIONADOS: A10 (claves foráneas faltantes), B06 (índices redundantes y
--                         compuestos), M06 (higiene de migraciones y reversión segura)
-- =================================================================================
-- ADVERTENCIA DE USO Y SEGURIDAD:
--   1. PROPUESTA LOCAL — CERO EJECUCIONES AUTOMÁTICAS EN PRODUCCIÓN (Clever Cloud).
--   2. NO EJECUTAR EN PRODUCCIÓN SIN RESPALDO PREVIO VERIFICADO Y AUTORIZACIÓN EXPLÍCITA.
--   3. Script 100% idempotente compatible con MySQL 8.0+ y MariaDB 10.11+ usando
--      `information_schema` + `PREPARE / EXECUTE / DEALLOCATE PREPARE`.
--   4. Precondición esperada: haber aplicado `migration_01`..`migration_05`
--      (o fixture sintético equivalente).
--   5. GARANTÍA NO DESTRUCTIVA: nunca elimina artículos, movimientos ni usuarios reales;
--      únicamente anula a NULL referencias huérfanas opcionales si existieran, protege
--      `inv_movimientos.articulo_id` con `ON DELETE RESTRICT`, agrega las llaves
--      foráneas faltantes y sustituye índices redundantes por índices compuestos reales.
-- =================================================================================

SET NAMES utf8mb4;

-- ---------------------------------------------------------------------------------
-- 1. Saneamiento NO destructivo de posibles referencias huérfanas antes de FKs
-- ---------------------------------------------------------------------------------
START TRANSACTION;

UPDATE `inv_articulos`
SET `campamento_id` = NULL,
    `estado_vinculacion_sede` = 'SIN_SEDE'
WHERE `campamento_id` IS NOT NULL
  AND `campamento_id` NOT IN (SELECT `id` FROM `inv_campamentos`);

UPDATE `inv_articulos`
SET `almacen_id` = NULL
WHERE `almacen_id` IS NOT NULL
  AND `almacen_id` NOT IN (SELECT `id` FROM `inv_almacenes`);

UPDATE `inv_articulos`
SET `lote_id` = NULL
WHERE `lote_id` IS NOT NULL
  AND `lote_id` NOT IN (SELECT `id` FROM `inv_lotes_importacion`);

UPDATE `inv_articulos`
SET `creado_por` = NULL
WHERE `creado_por` IS NOT NULL
  AND `creado_por` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_lotes_importacion`
SET `usuario_id` = NULL
WHERE `usuario_id` IS NOT NULL
  AND `usuario_id` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_movimientos`
SET `usuario_id` = NULL
WHERE `usuario_id` IS NOT NULL
  AND `usuario_id` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_auditoria`
SET `usuario_id` = NULL
WHERE `usuario_id` IS NOT NULL
  AND `usuario_id` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_levantamientos`
SET `almacen_id` = NULL
WHERE `almacen_id` IS NOT NULL
  AND `almacen_id` NOT IN (SELECT `id` FROM `inv_almacenes`);

UPDATE `inv_levantamientos`
SET `consolidado_por` = NULL
WHERE `consolidado_por` IS NOT NULL
  AND `consolidado_por` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_levantamiento_items`
SET `articulo_maestro_id` = NULL
WHERE `articulo_maestro_id` IS NOT NULL
  AND `articulo_maestro_id` NOT IN (SELECT `id` FROM `inv_articulos`);

UPDATE `inv_levantamiento_items`
SET `creado_por` = NULL
WHERE `creado_por` IS NOT NULL
  AND `creado_por` NOT IN (SELECT `id` FROM `inv_usuarios`);

UPDATE `inv_usuarios`
SET `campamento_id` = NULL
WHERE `campamento_id` IS NOT NULL
  AND `campamento_id` NOT IN (SELECT `id` FROM `inv_campamentos`);

UPDATE `inv_usuarios`
SET `almacen_id` = NULL
WHERE `almacen_id` IS NOT NULL
  AND `almacen_id` NOT IN (SELECT `id` FROM `inv_almacenes`);

DELETE FROM `inv_usuario_campamentos`
WHERE `usuario_id` NOT IN (SELECT `id` FROM `inv_usuarios`)
   OR `campamento_id` NOT IN (SELECT `id` FROM `inv_campamentos`);

DELETE FROM `inv_usuario_almacenes`
WHERE `usuario_id` NOT IN (SELECT `id` FROM `inv_usuarios`)
   OR `almacen_id` NOT IN (SELECT `id` FROM `inv_almacenes`);

COMMIT;

-- ---------------------------------------------------------------------------------
-- 2. Endurecimiento de inv_movimientos.articulo_id: cambiar ON DELETE CASCADE a RESTRICT
--    (Protege el historial del kárdex frente a eliminaciones físicas accidentales)
-- ---------------------------------------------------------------------------------
SET @v21_mov_fk_cascade_name := (
  SELECT kcu.CONSTRAINT_NAME
  FROM information_schema.KEY_COLUMN_USAGE kcu
  JOIN information_schema.REFERENTIAL_CONSTRAINTS rc
    ON rc.CONSTRAINT_SCHEMA = kcu.CONSTRAINT_SCHEMA
   AND rc.TABLE_NAME = kcu.TABLE_NAME
   AND rc.CONSTRAINT_NAME = kcu.CONSTRAINT_NAME
  WHERE kcu.TABLE_SCHEMA = DATABASE()
    AND kcu.TABLE_NAME = 'inv_movimientos'
    AND kcu.COLUMN_NAME = 'articulo_id'
    AND kcu.REFERENCED_TABLE_NAME = 'inv_articulos'
    AND rc.DELETE_RULE <> 'RESTRICT'
  LIMIT 1
);

SET @v21_drop_mov_fk_sql := IF(
  @v21_mov_fk_cascade_name IS NOT NULL,
  CONCAT('ALTER TABLE `inv_movimientos` DROP FOREIGN KEY `', @v21_mov_fk_cascade_name, '`'),
  'SELECT ''[migration_06] inv_movimientos.articulo_id no tiene FK no-RESTRICT.'' AS estado_fk'
);
PREPARE stmt_v21_drop_mov_fk FROM @v21_drop_mov_fk_sql;
EXECUTE stmt_v21_drop_mov_fk;
DEALLOCATE PREPARE stmt_v21_drop_mov_fk;

-- ---------------------------------------------------------------------------------
-- 3. Incorporación idempotente de las Claves Foráneas faltantes (A10)
-- ---------------------------------------------------------------------------------

-- 3.1 inv_movimientos(articulo_id) -> inv_articulos(id) ON DELETE RESTRICT
SET @v21_fk_exists := (
  SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_movimientos'
    AND COLUMN_NAME = 'articulo_id' AND REFERENCED_TABLE_NAME = 'inv_articulos'
);
SET @v21_fk_sql := IF(
  @v21_fk_exists = 0,
  'ALTER TABLE `inv_movimientos` ADD CONSTRAINT `fk_mov_articulo` FOREIGN KEY (`articulo_id`) REFERENCES `inv_articulos` (`id`) ON DELETE RESTRICT ON UPDATE CASCADE',
  'SELECT ''fk_mov_articulo ok'' AS estado_fk'
);
PREPARE stmt_fk FROM @v21_fk_sql; EXECUTE stmt_fk; DEALLOCATE PREPARE stmt_fk;

-- 3.2 inv_movimientos(usuario_id) -> inv_usuarios(id) ON DELETE SET NULL
SET @v21_fk_exists := (
  SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_movimientos'
    AND COLUMN_NAME = 'usuario_id' AND REFERENCED_TABLE_NAME = 'inv_usuarios'
);
SET @v21_fk_sql := IF(
  @v21_fk_exists = 0,
  'ALTER TABLE `inv_movimientos` ADD CONSTRAINT `fk_mov_usuario` FOREIGN KEY (`usuario_id`) REFERENCES `inv_usuarios` (`id`) ON DELETE SET NULL ON UPDATE CASCADE',
  'SELECT ''fk_mov_usuario ok'' AS estado_fk'
);
PREPARE stmt_fk FROM @v21_fk_sql; EXECUTE stmt_fk; DEALLOCATE PREPARE stmt_fk;

