-- ---------------------------------------------------------------------------------
-- 4. Índices compuestos óptimos y retiro de índices redundantes (B06)
-- ---------------------------------------------------------------------------------

-- 4.1 Índice compuesto de consultas principales en inv_articulos
SET @v21_idx_exists := (
  SELECT COUNT(*) FROM information_schema.STATISTICS
  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_articulos' AND INDEX_NAME = 'idx_art_filtro_compuesto'
);
SET @v21_idx_sql := IF(
  @v21_idx_exists = 0,
  'CREATE INDEX `idx_art_filtro_compuesto` ON `inv_articulos` (`activo`, `es_sintetico`, `campamento_id`, `area`)',
  'SELECT ''idx_art_filtro_compuesto ok'' AS estado_idx'
);
PREPARE stmt_idx FROM @v21_idx_sql; EXECUTE stmt_idx; DEALLOCATE PREPARE stmt_idx;

-- 4.2 Índice compuesto de consultas cronológicas en inv_movimientos
SET @v21_idx_exists := (
  SELECT COUNT(*) FROM information_schema.STATISTICS
  WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_movimientos' AND INDEX_NAME = 'idx_mov_sint_fecha'
);
SET @v21_idx_sql := IF(
  @v21_idx_exists = 0,
  'CREATE INDEX `idx_mov_sint_fecha` ON `inv_movimientos` (`es_sintetico`, `fecha_movimiento`)',
  'SELECT ''idx_mov_sint_fecha ok'' AS estado_idx'
);
PREPARE stmt_idx FROM @v21_idx_sql; EXECUTE stmt_idx; DEALLOCATE PREPARE stmt_idx;

-- 4.3 Retiro seguro de índices redundantes SOLO si un UNIQUE KEY ya cubre su prefijo izquierdo
SET @v21_has_redundant := (
  SELECT IF(
    EXISTS(SELECT 1 FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_usuarios' AND INDEX_NAME = 'idx_inv_usuarios_email')
    AND EXISTS(SELECT 1 FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'inv_usuarios' AND NON_UNIQUE = 0 AND COLUMN_NAME = 'email' AND SEQ_IN_INDEX = 1),
    1, 0
  )
);
SET @v21_drop_sql := IF(@v21_has_redundant = 1, 'DROP INDEX `idx_inv_usuarios_email` ON `inv_usuarios`', 'SELECT ''idx_inv_usuarios_email sin cambios'' AS estado_idx');
PREPARE stmt_idx FROM @v21_drop_sql; EXECUTE stmt_idx; DEALLOCATE PREPARE stmt_idx;

