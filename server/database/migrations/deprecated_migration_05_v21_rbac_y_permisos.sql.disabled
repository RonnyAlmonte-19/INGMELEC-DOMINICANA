-- =================================================================================
-- INGMELEC | ALMACÉN GENERAL (v2.1 — ETAPA 5)
-- PROPUESTA FUTURA IDEMPOTENTE: RBAC, DEFECTO SEGURO Y PERMISOS JSON
-- ARCHIVO: server/database/migrations/migration_05_v21_rbac_y_permisos.sql
-- HALLAZGOS / REQUISITOS RELACIONADOS: Etapa 5 — RBAC estricto y defecto seguro
-- =================================================================================
-- ADVERTENCIA DE USO Y SEGURIDAD:
--   1. PROPUESTA LOCAL — CERO EJECUCIONES AUTOMÁTICAS EN PRODUCCIÓN (Clever Cloud).
--   2. NO EJECUTAR EN PRODUCCIÓN SIN RESPALDO PREVIO VERIFICADO Y AUTORIZACIÓN EXPLÍCITA.
--   3. Script 100% idempotente y determinista compatible con MySQL 8.0+ y MariaDB 10.11+
--      usando transacción atómica, `JSON_VALID(COALESCE(permisos_json, ''))`,
--      `JSON_TYPE`, `JSON_LENGTH`, `JSON_CONTAINS`, `JSON_SEARCH` y `JSON_ARRAY_APPEND`.
--   4. Precondición esperada: haber aplicado `migration_01`..`migration_04`
--      (o fixture sintético equivalente con `inv_usuarios.permisos_json` y `es_developer`).
--   5. GARANTÍA DE INTEGRIDAD OPERATIVA:
--      - CERO modificaciones sobre `inv_articulos`, `inv_campamentos`,
--        `inv_movimientos` o `inv_levantamientos`.
--      - Nunca convierte cuentas con `'[]'` vacío ni cuentas inactivas (`activo = 0`)
--        en cuentas con acceso; conserva defecto seguro sin privilegios.
-- =================================================================================

SET NAMES utf8mb4;

START TRANSACTION;

-- ---------------------------------------------------------------------------------
-- 1. Defecto seguro sin acceso: garantizar que `inv_usuarios.permisos_json` nunca
--    quede NULL, inválido o no-arreglo en cuentas no developer
-- ---------------------------------------------------------------------------------
UPDATE `inv_usuarios`
SET `permisos_json` = '[]'
WHERE `id` >= 0
  AND (`es_developer` = 0 OR LOWER(TRIM(COALESCE(`rol`, ''))) <> 'developer')
  AND CASE
    WHEN `permisos_json` IS NULL THEN 1
    WHEN JSON_VALID(COALESCE(`permisos_json`, '')) = 0 THEN 1
    WHEN JSON_TYPE(`permisos_json`) <> 'ARRAY' THEN 1
    ELSE 0
  END = 1;

-- ---------------------------------------------------------------------------------
-- 2. Anti-autoescalamiento: para cuentas no developer (`es_developer = 0` o
--    `rol <> 'developer'`) donde `permisos_json` contenga wildcard '*', limpiar a
--    defecto seguro '[]' sin elevar privilegios
-- ---------------------------------------------------------------------------------
UPDATE `inv_usuarios`
SET `permisos_json` = '[]'
WHERE `id` >= 0
  AND (`es_developer` = 0 OR LOWER(TRIM(COALESCE(`rol`, ''))) <> 'developer')
  AND CASE
    WHEN `permisos_json` IS NULL THEN 0
    WHEN JSON_VALID(COALESCE(`permisos_json`, '')) = 0 THEN 0
    WHEN JSON_CONTAINS(`permisos_json`, '"*"') = 1 THEN 1
    WHEN JSON_SEARCH(`permisos_json`, 'one', '*') IS NOT NULL THEN 1
    ELSE 0
  END = 1;

-- ---------------------------------------------------------------------------------
-- 3. Cuenta principal developer: asegurar que la única cuenta principal
--    (`es_developer = 1 AND rol = 'developer'`) conserve exactamente '["*"]'
-- ---------------------------------------------------------------------------------
UPDATE `inv_usuarios`
SET `permisos_json` = '["*"]'
WHERE `id` >= 0
  AND `es_developer` = 1
  AND LOWER(TRIM(COALESCE(`rol`, ''))) = 'developer'
  AND CASE
    WHEN `permisos_json` IS NULL THEN 1
    WHEN JSON_VALID(COALESCE(`permisos_json`, '')) = 0 THEN 1
    WHEN JSON_TYPE(`permisos_json`) <> 'ARRAY' THEN 1
    WHEN JSON_LENGTH(`permisos_json`) <> 1 THEN 1
    WHEN JSON_CONTAINS(`permisos_json`, '"*"') = 0 THEN 1
    ELSE 0
  END = 1;

-- ---------------------------------------------------------------------------------
-- 4.1 Continuidad operativa ('dash:ver'): para cuentas activas existentes
--     (`es_developer = 0 AND activo = 1`) cuya `permisos_json` ya contenga permisos
--     no vacíos (`JSON_VALID` y `JSON_LENGTH > 0`), agregar 'dash:ver' de forma
--     idempotente (SIN tocar cuentas con '[]' vacío ni cuentas inactivas)
-- ---------------------------------------------------------------------------------
UPDATE `inv_usuarios`
SET `permisos_json` = JSON_ARRAY_APPEND(`permisos_json`, '$', 'dash:ver')
WHERE `id` >= 0
  AND `es_developer` = 0
  AND LOWER(TRIM(COALESCE(`rol`, ''))) <> 'developer'
  AND `activo` = 1
  AND CASE
    WHEN `permisos_json` IS NULL THEN 0
    WHEN JSON_VALID(COALESCE(`permisos_json`, '')) = 0 THEN 0
    WHEN JSON_TYPE(`permisos_json`) <> 'ARRAY' THEN 0
    WHEN JSON_LENGTH(`permisos_json`) <= 0 THEN 0
    WHEN JSON_CONTAINS(`permisos_json`, '"*"') <> 0 THEN 0
    WHEN JSON_CONTAINS(`permisos_json`, '"dash:ver"') = 0 THEN 1
    ELSE 0
  END = 1;

-- ---------------------------------------------------------------------------------
-- 4.2 Bitácora / Auditoría ('aud:ver'): únicamente a cuentas activas con
--     `rol IN ('admin', 'auditor', 'gerencia')` y permisos no vacíos (`JSON_LENGTH > 0`)
-- ---------------------------------------------------------------------------------
UPDATE `inv_usuarios`
SET `permisos_json` = JSON_ARRAY_APPEND(`permisos_json`, '$', 'aud:ver')
WHERE `id` >= 0
  AND `es_developer` = 0
  AND `activo` = 1
  AND LOWER(TRIM(COALESCE(`rol`, ''))) IN ('admin', 'auditor', 'gerencia')
  AND CASE
    WHEN `permisos_json` IS NULL THEN 0
    WHEN JSON_VALID(COALESCE(`permisos_json`, '')) = 0 THEN 0
    WHEN JSON_TYPE(`permisos_json`) <> 'ARRAY' THEN 0
    WHEN JSON_LENGTH(`permisos_json`) <= 0 THEN 0
    WHEN JSON_CONTAINS(`permisos_json`, '"*"') <> 0 THEN 0
    WHEN JSON_CONTAINS(`permisos_json`, '"aud:ver"') = 0 THEN 1
    ELSE 0
  END = 1;

COMMIT;

