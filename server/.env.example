# ========================================================================
# INGMELEC | ALMACÉN GENERAL - VARIABLES DE ENTORNO DEL BACKEND
# Ejemplo seguro de configuración (Copiar a .env y configurar valores reales)
# ========================================================================

# Configuración de Servidor Express
PORT=5000
NODE_ENV=production
# Modo mantenimiento (true: bloquea POST, PUT, PATCH, DELETE con 503 durante migraciones)
MAINTENANCE_MODE=false

# Base de Datos MySQL Relacional (Clever Cloud, AWS RDS, o Local)
DB_HOST=tu-host-mysql.services.clever-cloud.com
DB_PORT=3306
DB_USER=tu-usuario-mysql
DB_PASSWORD=tu-contrasena-segura
DB_NAME=tu-base-de-datos
DB_SSL=true
# Solo usar DB_SSL_ALLOW_INSECURE=true en entornos locales sin CA (nunca en producción)
# DB_SSL_ALLOW_INSECURE=false
DB_CONNECTION_LIMIT=2

# Seguridad HTTP, Proxy Inverso y CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
TRUST_PROXY=1

# Clave Secreta para Firma Criptográfica de Tokens JWT (HS256, mínimo 32 caracteres) y TTL
JWT_SECRET=reemplazar-por-clave-criptografica-aleatoria-minimo-32-caracteres
JWT_TTL_HOURS=12

# --- v2.2: módulo Actas de Entrega (DESACTIVADO por defecto; solo "true" lo activa) ---
ACTAS_ENABLED=false

# --- v2.2: filtros por fecha (consulta). Zona del usuario y zona en que la BASE guarda sus DATETIME ---
# APP_TIMEZONE_OFFSET: zona del "dia" del usuario (America/Santo_Domingo = -04:00, sin horario de verano).
# DB_TIME_OFFSET: zona en que la base guarda las horas. Si la base guarda UTC, use +00:00.
# Verifique con: SELECT @@global.time_zone, NOW(), UTC_TIMESTAMP();  Sin definir, se asume la zona de la aplicacion.
APP_TIMEZONE_OFFSET=-04:00
# DB_TIME_OFFSET=+00:00
