# ==============================================================================
# INGMELEC | ALMACÉN GENERAL — REGLAS DE EXCLUSIÓN GIT (.gitignore)
# Protege secretos, respaldos, volcados SQL/JSON, datos locales y suites de QA
# ==============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencias y artefactos de compilación
node_modules/
server/node_modules/
dist/
dist-ssr/
*.local

# Variables de entorno, credenciales y secretos (NUNCA PUBLICAR)
.env
.env.*
server/.env
server/.env.*
*.env
*.env.*
!.env.example
!server/.env.example
!**/.env.example
*.pem
!server/certs/clever-cloud-mysql-ca.pem
*.key
*.crt

# Respaldos, volcados de bases de datos y hojas Excel sensibles
server/backups/
backups/
*.bak
*.sql.gz
*.dump
*privado*.sql
gridops_mysql_dump.sql
server/data/*.xlsx
*.xlsx
*.xls
server/scripts/*.json
!server/database/migrations/*.sql

# Entornos de prueba aislados, scripts de QA, Playwright y carpetas temporales
scratch/
/scripts/
archive/
e2e/
playwright-report/
test-results/
playwright.config.js
server/tests/*.db
server/tests/*.sqlite*
server/tests/**/*.db
server/tests/**/*.sqlite*
server/tests/**/*.log
server/tests/**/*.png
server/tests/**/*.jpg
server/tests/**/*.tmp
server/tests/tmp/
server/tests/logs/
server/tests/screenshots/
server/tests/**/*privado*
server/tests/**/*secret*
server/tests/e2e_playwright_cdp_disposable.mjs
server/tests/e2e_production_migration_validation.mjs
server/scripts/*
!server/scripts/recovery-developer.js
# v2.2: lanzador local sintetico y E2E de navegador (sin secretos; las credenciales van en server/.env.dev-credenciales, ignorado)
!server/scripts/dev-local-v22.mjs
!server/scripts/e2e-actas-ui.mjs
!server/scripts/e2e-fechas-ui.mjs
!server/scripts/e2e-cantidades-ui.mjs
!server/scripts/e2e-filtros-ui.mjs
server/start-test-server.js
server/test-hash.js
server/check-db.js
check-db.js
test-api.js

# Directorios de editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
